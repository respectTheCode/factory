# Copy this file to the deployment environment and replace every deployment
# value before running Compose or configuring Dokploy.  The operator secret is
# a host file; its contents never belong in this file or in the image.
FACTORY_ENVIRONMENT=production
FACTORY_IMAGE=factory:st-162

# Bind only the private LAN interface.  The host port is deliberately separate
# from the container port so the pilot can use 3101 without Dokploy's 3000.
FACTORY_BIND_IP=192.168.6.100
FACTORY_PUBLIC_PORT=3101
FACTORY_DATA_VOLUME=factory-data

# This path is read by Compose on the host to create a read-only secret mount.
FACTORY_OPERATOR_NAME=Kevin
FACTORY_OPERATOR_SECRET_FILE=/opt/factory/secrets/operator-secret

# Normal production startup must find a pre-seeded database in the named
# volume.  Run the isolated pilot initializer manually before first pilot use.
FACTORY_REQUIRE_EXISTING_DB=true
FACTORY_ALLOWED_ORIGINS=https://factory.example.internal
