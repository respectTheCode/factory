{
  "name": "software-factory",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run typecheck && bun run build:web",
    "build:web": "bun build ./src/web/main.tsx ./src/web/service-worker.ts --outdir ./dist --target browser",
    "dev": "FACTORY_PORT=3001 bun run start",
    "format": "prettier --check package.json tsconfig.json src tests",
    "format:write": "prettier --write package.json tsconfig.json src tests",
    "service:deploy": "bash ./scripts/deploy-user-service.sh",
    "start": "bun run build && bun run src/server.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "5.101.4",
    "@trpc/client": "11.18.0",
    "@trpc/react-query": "11.18.0",
    "@trpc/server": "11.18.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/ws": "8.18.1",
    "bun-types": "1.3.14",
    "prettier": "3.7.4",
    "typescript": "5.9.3"
  }
}
